#!/bin/sh
# set -u
function error () { printf >&2 "%s\n\nPlease see README.md for build instructions.\n" "$1"; exit 1; }

# ===============================
# = Check required dependencies =
# ===============================

for dep in capnp ninja ragel multimarkdown pgrep pkill; do
	which -s "$dep" || error "*** dependency missing: ‘${dep}’."
done

if [[ -e local.rave ]]; then
	echo >&2 "Skipping writing ‘local.rave’: File already exists"
else
	# Homebrew installs under /opt/homebrew on Apple Silicon and /usr/local on
	# Intel; MacPorts uses /opt/local. PREFIX overrides the detection.
	if [[ -z "$PREFIX" ]]; then
		if which -s brew; then PREFIX="$(brew --prefix)"
		elif [[ -d /opt/local/include ]]; then PREFIX=/opt/local
		else PREFIX=/usr/local
		fi
	fi

	for hdr in boost/{crc,variant}.hpp capnp/{message,serialize-packed}.h sparsehash/dense_hash_map; do
		test -f "${PREFIX}/include/${hdr}" || error "*** dependency missing: ‘${PREFIX}/include/${hdr}’. Install dependency or rerun with PREFIX set to the right location."
	done

	for lib in capnp kj; do
		set -- "${PREFIX}/lib/lib${lib}."*
		test -f "$1" || error "*** dependency missing: ‘${PREFIX}/lib/lib${lib}.*’. Install dependency or rerun with PREFIX set to the right location."
	done

	# GNU libiconv is linked statically in place of the system library: the
	# iconv shipped with current macOS transliterates differently (for
	# example when saving as ASCII//TRANSLIT), so text conversion would depend
	# on the OS version. Homebrew keeps it out of its main prefix.
	if [[ -z "$ICONV_PREFIX" ]]; then
		if [[ -f "${PREFIX}/opt/libiconv/lib/libiconv.a" ]]; then ICONV_PREFIX="${PREFIX}/opt/libiconv"
		else ICONV_PREFIX="$PREFIX"
		fi
	fi

	test -f "${ICONV_PREFIX}/lib/libiconv.a" || error "*** dependency missing: ‘${ICONV_PREFIX}/lib/libiconv.a’ (GNU libiconv). Install dependency or rerun with ICONV_PREFIX set to the right location."
	grep -qs libiconv_open "${ICONV_PREFIX}/include/iconv.h" || error "*** ‘${ICONV_PREFIX}/include/iconv.h’ is not the GNU libiconv header. Install GNU libiconv or rerun with ICONV_PREFIX set to the right location."

	# Link capnp and kj statically when archives are available, so the built
	# application does not depend on libraries outside the system. The linker
	# prefers a dynamic library within a directory, hence a directory that
	# holds only the archives, searched first.
	STATIC_DIR="${PWD}/.static-libs"
	rm -rf "$STATIC_DIR" && mkdir "$STATIC_DIR"
	for lib in capnp kj; do
		if [[ -f "${PREFIX}/lib/lib${lib}.a" ]]; then
			ln -s "${PREFIX}/lib/lib${lib}.a" "$STATIC_DIR/"
		else
			echo >&2 "*** warning: ‘${PREFIX}/lib/lib${lib}.a’ not found; ‘${lib}’ will be linked dynamically and the application will only run where it is installed."
		fi
	done

	ln -s "${ICONV_PREFIX}/lib/libiconv.a" "$STATIC_DIR/"

	# The GNU iconv.h must be found before the one in the SDK.
	if [[ "$ICONV_PREFIX" == "$PREFIX" ]];
		then echo >> local.rave "add FLAGS    \"-I${PREFIX}/include\""
		else echo >> local.rave "add FLAGS    \"-I${ICONV_PREFIX}/include -I${PREFIX}/include\""
	fi
	echo >> local.rave "add LN_FLAGS \"-L${STATIC_DIR} -L${PREFIX}/lib\""
fi

# ========================
# = Generate build files =
# ========================

if [[ -d "$builddir" ]];
	then bin/rave -crelease -tRouvre -b"$builddir"
	else bin/rave -crelease -tRouvre
fi
