#!/usr/bin/env python3
"""Pack PNG renderings of an icon into a macOS .icns file.

Usage: bin/gen_icns <png-dir> <output.icns>

<png-dir> must hold icon_16.png, icon_32.png, icon_64.png, icon_128.png,
icon_256.png, icon_512.png and icon_1024.png, rendered from the SVG source
(Applications/TextMate/artwork/Rouvre.svg) with a transparent background.
"""
import struct, sys, os

# OSType -> pixel size of the PNG stored under it
ENTRIES = [
	(b'icp4', 16), (b'icp5', 32), (b'icp6', 64),
	(b'ic07', 128), (b'ic08', 256), (b'ic09', 512), (b'ic10', 1024),
	(b'ic11', 32), (b'ic12', 64), (b'ic13', 256), (b'ic14', 512),
]

def main(src, dst):
	body = b''
	for ostype, size in ENTRIES:
		with open(os.path.join(src, 'icon_%d.png' % size), 'rb') as f:
			png = f.read()
		if png[:8] != b'\x89PNG\r\n\x1a\n':
			sys.exit('not a PNG file: icon_%d.png' % size)
		body += ostype + struct.pack('>I', len(png) + 8) + png
	with open(dst, 'wb') as f:
		f.write(b'icns' + struct.pack('>I', len(body) + 8) + body)

if __name__ == '__main__':
	if len(sys.argv) != 3:
		sys.exit(__doc__)
	main(sys.argv[1], sys.argv[2])
